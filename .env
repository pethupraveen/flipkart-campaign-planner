# Copy to .env and fill in. Never commit .env.

# ---- Server ----
PORT=4000
# Long random secret — the frontend must send this in the x-api-key header.
API_KEY=change-me-to-a-long-random-string

# ---- Database ----
DB_PATH=./data.sqlite

# ---- Mailbox that receives Flipkart's scheduled report email ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=yourreports@yourstore.com
# Gmail/Outlook: use an "app password", not your normal login password.
IMAP_PASS=your-app-password

# Text that appears in the subject of Flipkart's scheduled report email —
# check an actual received email and adjust if needed.
REPORT_SUBJECT_MATCH=Scheduled Report

# ---- Cron ----
# 10:15am daily by default (15 min after Flipkart's 10:00 schedule).
FETCH_CRON=15 10 * * *
ENABLE_CRON=true
